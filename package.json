{
  "name": "helios-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
 "scripts": {
  "dev:api": "npm run --workspace=api start:dev",
  "dev:web": "npm run --workspace=web dev",
  "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\""
},
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
