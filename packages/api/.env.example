# DATABASE
DATABASE_URL="postgresql://helios_user:your_super_strong_password@localhost:5432/helios_dev?schema=public"

# ALPACA BROKER API (PAPER TRADING)
ALPACA_API_KEY="YOUR_PAPER_API_KEY"
ALPACA_SECRET_KEY="YOUR_PAPER_SECRET_KEY"

# TRADING CONFIGURATION
MOCK_TRADING="true" # Set to "true" to enable mock mode (no real trades)

# LANGCHAIN - OPENAI for Agent
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Secret for signing the session cookie
SESSION_SECRET="A_VERY_RANDOM_AND_STRONG_SECRET_KEY_FOR_SESSIONS"

# Frontend
FRONTEND_URL="http://localhost:3001"

# Master key for encrypting API keys in the database
ENCRYPTION_KEY="A_32_BYTE_LONG_MASTER_ENCRYPTION_KEY_FOR_AES_256"

# HELIOS FINANCE (server-only; Sandbox only in this milestone)
# Copy values from the Plaid dashboard's Sandbox keys, not the Production secret.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
# Generate local database, encryption and session secrets:
# node scripts/setup-finance-env.mjs (from repository root)
# It writes ignored packages/api/.env.finance.local. Keep its encryption key stable.
FINANCE_MODEL="gpt-6-luna"
# Optional; must be registered in the Plaid dashboard for OAuth institutions.
PLAID_REDIRECT_URI=""

# Classification only; no automatic fallback between recipients.
FINANCE_CLASSIFIER="luna" # luna | jev
FINANCE_LUNA_PROVIDER="openai" # openai | openrouter
FINANCE_JEV_PROVIDER="typesafe" # typesafe | openrouter
TYPESAFE_API_KEY=""
FINANCE_JEV_MODEL="jev-latest"
OPENROUTER_API_KEY=""
OPENROUTER_LUNA_MODEL="openai/gpt-6-luna"
OPENROUTER_JEV_MODEL="typesafe/jev-1.14"
# Required for routed Luna; Jev defaults to TypeSafe. No provider fallback.
OPENROUTER_PROVIDERS=""
